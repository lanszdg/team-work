{
  "name": "team-collab-sync-server",
  "version": "1.0.0",
  "description": "Local Team Memory Sync Server for the team-collab-plugin",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc && node ./scripts/copy-static.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "node ./node_modules/typescript/bin/tsc --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
